# ============================================================
# C1AfterSetup — .gitignore
# Build artifacts, IDE state and local test fixtures.
# ============================================================

# --- MSBuild / Visual Studio output (console app) ---
C1AfterSetup/bin/
C1AfterSetup/obj/
.vs/
*.suo
*.user
*.userprefs

# NOTE: sources/bin/ is intentionally tracked — it holds the
# deployable dependency DLL (BCrypt.Net-Next.dll) shipped to ~/bin.

# --- Local test fixtures and runtime backups ---
testdata/
backups/

# --- OS / editor noise ---
Thumbs.db
Desktop.ini
.DS_Store
*.log
*.tmp
