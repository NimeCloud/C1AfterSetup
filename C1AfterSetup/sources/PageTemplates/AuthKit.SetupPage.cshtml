@inherits RazorPageTemplate
@using Composite.Data
@using Composite.Data.Types
@using System
@using System.Linq
@using System.Web

@functions {
    public override void Configure()
    {
        TemplateId = new Guid("a1b0a1b0-0000-0000-0000-a1b0a1b0a1b0");
        TemplateTitle = "AuthKit.SetupPage";
        Layout = null;
    }

    [Placeholder(Id = "content", Title = "Content", IsDefault = true)]
    public XhtmlDocument Content { get; set; }

    private static readonly Guid DefaultPageTypeId = new Guid("f7869eb2-7369-4eb2-af47-e3be261e92c7");
    private static readonly Guid AuthLayoutTemplateId = new Guid("24e07eb6-17c9-424e-9c16-219f57a85900");
    private static readonly Guid RootPageId = new Guid("00000000-0000-0000-0000-000000000000");

    public string CreateAuthPages()
    {
        var log = new System.Text.StringBuilder();
        using (var conn = new DataConnection())
        {
            var pagesToCreate = new[] {
                (TemplateId: new Guid("f9a2e1d7-8c3b-4b2a-9e1f-1a2b3c4d5e6f"), Title: "Users", UrlTitle: "Users", MenuTitle:
"Users"),
                (TemplateId: new Guid("50562763-9421-40b6-8897-5214ab170051"), Title: "Groups", UrlTitle: "Groups", MenuTitle:
"Groups"),
                (TemplateId: new Guid("ff5a0c90-7f64-4e56-b9b9-1c078276f4c2"), Title: "Group Permissions", UrlTitle:
"Group-Permissions", MenuTitle: "Group Permissions"),
                (TemplateId: new Guid("70d2e0d8-d2d1-4209-a5ae-a0bc7d283a9d"), Title: "User Permissions", UrlTitle: "User-Permissions",
MenuTitle: "User Permissions"),
                (TemplateId: AuthLayoutTemplateId, Title: "Login", UrlTitle: "Login", MenuTitle: "Login"),
                (TemplateId: AuthLayoutTemplateId, Title: "Register", UrlTitle: "Register", MenuTitle: "Register"),
                (TemplateId: AuthLayoutTemplateId, Title: "Forgot Password", UrlTitle: "Forgot-Password", MenuTitle: "Forgot Password"),
                (TemplateId: AuthLayoutTemplateId, Title: "Reset Password", UrlTitle: "Reset-Password", MenuTitle: "Reset Password"),
                (TemplateId: AuthLayoutTemplateId, Title: "Logout", UrlTitle: "Logout", MenuTitle: "Logout"),
            };

            foreach (var page in pagesToCreate)
            {
                var existing = conn.Get<IPage>().FirstOrDefault(p => p.UrlTitle == page.UrlTitle);
                if (existing != null)
                {
                    log.AppendLine(string.Format("SKIPPED: '{0}' already exists (ID: {1})", page.Title, existing.Id));
                    continue;
                }

                try
                {
                    var newPage = conn.CreateNew<IPage>();
                    newPage.Id = Guid.NewGuid();
                    newPage.TemplateId = page.TemplateId;
                    newPage.PageTypeId = DefaultPageTypeId;
                    newPage.Title = page.Title;
                    newPage.MenuTitle = page.MenuTitle;
                    newPage.UrlTitle = page.UrlTitle;
                    newPage.FriendlyUrl = "";
                    newPage.Description = "";
                    newPage.SourceCultureName = "tr-TR";
                    newPage.PublicationStatus = "published";
                    newPage.CreationDate = DateTime.Now;
                    newPage.ChangeDate = DateTime.Now;
                    newPage.ChangedBy = "admin";
                    newPage.CreatedBy = "admin";
                    newPage.VersionId = Guid.NewGuid();
                    conn.Add(newPage);

                    var structure = conn.CreateNew<IPageStructure>();
                    structure.Id = newPage.Id;
                    structure.ParentId = RootPageId;
                    structure.LocalOrdering = 99;
                    conn.Add(structure);

                    log.AppendLine(string.Format("CREATED: '{0}' -> /{1} (ID: {2})", page.Title, page.UrlTitle, newPage.Id));

                    if (page.UrlTitle == "Login")
                    {
                        try { AuthKit.Authentication.AuthenticationManager.LoginPageId = newPage.Id; } catch { }
                        log.AppendLine(string.Format("  -> LoginPageId: {0}", newPage.Id));
                    }
                    if (page.UrlTitle == "Reset-Password")
                    {
                        try { AuthKit.Authentication.AuthenticationManager.ResetPasswordPageId = newPage.Id; } catch { }
                        log.AppendLine(string.Format("  -> ResetPasswordPageId: {0}", newPage.Id));
                    }
                }
                catch (Exception ex)
                {
                    log.AppendLine(string.Format("ERROR: '{0}' could not be created: {1}", page.Title, ex.Message));
                }
            }

            try
            {
                if (AuthKit.Authentication.AuthenticationManager.LoginPageId != Guid.Empty)
                    AuthKit.Settings.SettingsManager.Set("Auth.LoginPageId",
AuthKit.Authentication.AuthenticationManager.LoginPageId.ToString());
                if (AuthKit.Authentication.AuthenticationManager.ResetPasswordPageId != Guid.Empty)
                    AuthKit.Settings.SettingsManager.Set("Auth.ResetPasswordPageId",
AuthKit.Authentication.AuthenticationManager.ResetPasswordPageId.ToString());
            }
            catch { }
        }
        return log.ToString();
    }
}

@{
    // C1 output-cache (C1Page, duration=60) keyed by URL, NOT by authToken cookie —
    // disables caching so setup/auth flows render fresh every request.
    HttpContext.Current.Response.Cache.SetCacheability(HttpCacheability.NoCache);
    HttpContext.Current.Response.Cache.SetNoStore();
    var action = Request["action"];
    var result = "";
    var typesReady = false;
    var initDone = false;
    var saveOAuthMessage = "";
    var tablerIconsUrl = "https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css";
    var currentUser = AuthKit.Authentication.AuthenticationManager.GetCurrentUser();

    // HARDCODED ADMIN GATE: Setup/yönetim eylemleri yalnızca yetkili kullanıcılar içindir.
    // Kural önceliği: önce DB'den zorlamalı engel (DENY) / yetki (ALLOW) kontrol edilir;
    // ikisi de yoksa System.Administrators üyeliğine bakılır. Böylece eskiden admin olan
    // biri, admin üyeliği kaldırılmadan tek tek yetkilerden engellenebilir.
    bool isAdmin = false;
    if (currentUser != null)
    {
        try
        {
            isAdmin = AuthKit.Authorization.AuthorizationManager.HasPermission(
                currentUser, AuthKit.Authorization.PermissionKeys.Auth.Users.View);
        }
        catch { }
    }

    // AuthKit init check (bootstrap herkes için çalışır; yönetim eylemleri ayrıca korunur)
    try
    {
        initDone = AuthKit.Startup.AuthStartupHandler.IsInitialized;
        if (!initDone)
        {
            AuthKit.Startup.AuthStartupHandler.Initialize();
            initDone = true;
        }
        typesReady = true;
    }
    catch (Exception ex)
    {
        typesReady = false;
    }

    if (action == "create" && typesReady && isAdmin)
    {
        result = CreateAuthPages();
    }

    if (action == "saveoauth" && isAdmin)
    {
        try
        {
            var googleClientId = (Request["googleClientId"] ?? "").Trim();
            var facebookAppId = (Request["facebookAppId"] ?? "").Trim();
            AuthKit.Settings.SettingsManager.Set("Auth.OAuth.Google.ClientId", googleClientId);
            AuthKit.Settings.SettingsManager.Set("Auth.OAuth.Facebook.AppId", facebookAppId);
            saveOAuthMessage = "OAuth settings saved successfully.";
        }
        catch (Exception ex)
        {
            saveOAuthMessage = "Failed to save OAuth settings: " + ex.Message;
        }
    }
}

<!DOCTYPE html>
<html>

<head>
    <title>AuthKit Setup</title>
    <link href="~/assets/authkit/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="@tablerIconsUrl" />
    <style>
            .authkit-navbar {
                background-color: #1f2937;
                color: #fff;
            }

            .authkit-navbar .navbar-brand {
                color: #fff;
                font-weight: 600;
            }

            .authkit-navbar .nav-link {
                color: #cbd5e1;
            }

            .authkit-navbar .nav-link:hover,
            .authkit-navbar .nav-link.active {
                color: #fff;
            }
    </style>
</head>

<body>
    @if (isAdmin)
    {
        <nav class="navbar navbar-expand-lg authkit-navbar mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" href="~/">
                    <i class="ti ti-shield-lock me-1"></i>AuthKit
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#authkitNav"
                        aria-controls="authkitNav" aria-expanded="false" aria-label="Toggle menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="authkitNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link"
                               href="@AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("b2b02000-0000-0000-0000-b2b0b2b0b2b0"), "~/Users")">
                                <i class="ti ti-users me-1"></i>Users
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               href="@AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("c3c03000-0000-0000-0000-c3c0c3c0c3c0"), "~/Groups")">
                                <i class="ti ti-users-group me-1"></i>Groups
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               href="@AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("d4d04000-0000-0000-0000-d4d0d4d0d4d0"), "~/Group-Permissions")">
                                <i class="ti ti-shield-check me-1"></i>Group Permissions
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               href="@AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("e5e05000-0000-0000-0000-e5e0e5e0e5e0"), "~/User-Permissions")">
                                <i class="ti ti-key me-1"></i>User Permissions
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item">
                            <span class="navbar-text text-white-50 me-2"><i class="ti ti-user me-1"></i> @(currentUser !=
                                                                                                                            null ? currentUser.UserName : "")</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   href="@AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("d0d0a000-0000-0000-0000-d0d0d0d0d0d0"), "~/Logout")">
                                    <i class="ti ti-logout me-1"></i>Logout
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        }

        <div class="p-4">
            <div class="container">
                <h2>AuthKit Setup Panel</h2>

                @if (!isAdmin)
                {
                    <div class="authkit-card p-5 mx-auto text-center" style="max-width: 480px;">
                        <div class="mb-2">
                            <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill px-3 py-2">
                                <i class="ti ti-user me-1"></i> @(currentUser != null ? currentUser.UserName : "")
                            </span>
                        </div>
                        <i class="ti ti-shield-lock text-danger" style="font-size: 3rem;"></i>
                        <h3 class="mt-3 mb-2">Access Denied</h3>
                        <p class="text-muted mb-4">You are signed in, but you do not have permission to access the AuthKit
                            setup panel. Only members of the <strong>System.Administrators</strong> group can use this area.</p>
                            <a href="@AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("d0d0a000-0000-0000-0000-d0d0d0d0d0d0"), "~/Logout")"
                               class="btn btn-outline-secondary w-100 py-2">Sign in with a different account</a>
                        </div>
                    }
            else if (!typesReady)
                    {
                        <div class="alert alert-warning">
                            <h5>Data Types Not Loaded Yet</h5>
                            <p>AuthKit DLL and DataMetaData files were copied, but C1 CMS has not yet registered the new data types.
                            </p>
                            <p><strong>What you need to do:</strong></p>
                            <ol>
                                <li>Go to this address: <a href="/Composite/updated.aspx"
                                                               target="_blank"><code>/Composite/updated.aspx</code></a></li>
                                    <li>This page will make C1 CMS recompile the types</li>
                                    <li>Then refresh this page (F5)</li>
                                </ol>
                            </div>
                        }
    else
                        {
                            if (!string.IsNullOrEmpty(result))
                            {
                                <div class="alert alert-info">
                                    <pre>@result</pre>
                                </div>
                            }

                            <div class="alert @(initDone ? "alert-success" : "alert-info")">
                                AuthKit status: <strong>@(initDone ? "Initialized" : "Initializing...")</strong>
                                @if (initDone)
                                {
                                    <span> - GroupKeys and Permission synchronization completed.</span>
                                }
                            </div>

                            <div class="card mb-3">
                                <div class="card-header">AuthKit Pages</div>
                                <div class="card-body">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Page</th>
                                                <th>Link</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>User Management</td>
                                                <td><a href="@AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("b2b02000-0000-0000-0000-b2b0b2b0b2b0"), "~/Users")"
                                                           class="btn btn-sm btn-outline-primary">Open</a></td>
                                                </tr>
                                                <tr>
                                                    <td>Group Management</td>
                                                    <td><a href="@AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("c3c03000-0000-0000-0000-c3c0c3c0c3c0"), "~/Groups")"
                                                               class="btn btn-sm btn-outline-primary">Open</a></td>
                                                    </tr>
                                                    <tr>
                                                        <td>Group Permissions</td>
                                                        <td><a href="@AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("d4d04000-0000-0000-0000-d4d0d4d0d4d0"), "~/Group-Permissions")"
                                                                   class="btn btn-sm btn-outline-primary">Open</a></td>
                                                        </tr>
                                                        <tr>
                                                            <td>User Permissions</td>
                                                            <td><a href="@AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("e5e05000-0000-0000-0000-e5e0e5e0e5e0"), "~/User-Permissions")"
                                                                       class="btn btn-sm btn-outline-primary">Open</a></td>
                                                            </tr>
                                                            <tr>
                                                                <td>Login</td>
                                                                <td><a href="@AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("f6f06000-0000-0000-0000-f6f0f6f0f6f0"), "~/Login")"
                                                                           class="btn btn-sm btn-outline-primary">Open</a></td>
                                                                </tr>
                                                                <tr>
                                                                    <td>Register</td>
                                                                    <td><a href="@AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("a7a07000-0000-0000-0000-a7a0a7a0a7a0"), "~/Register")"
                                                                               class="btn btn-sm btn-outline-primary">Open</a></td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td>Forgot Password</td>
                                                                        <td><a href="@AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("b8b08000-0000-0000-0000-b8b0b8b0b8b0"), "~/Forgot-Password")"
                                                                                   class="btn btn-sm btn-outline-primary">Open</a></td>
                                                                        </tr>
                                                                        <tr>
                                                                            <td>Reset Password</td>
                                                                            <td><a href="@AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("c9c09000-0000-0000-0000-c9c0c9c0c9c0"), "~/Reset-Password")"
                                                                                       class="btn btn-sm btn-outline-primary">Open</a></td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td>Logout</td>
                                                                                <td><a href="@AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("d0d0a000-0000-0000-0000-d0d0d0d0d0d0"), "~/Logout")"
                                                                                           class="btn btn-sm btn-outline-primary">Open</a></td>
                                                                                </tr>
                                                                            </tbody>
                                                                        </table>
                                                                    </div>
                                                                </div>

                                                                <div class="card mb-3">
                                                                    <div class="card-header">OAuth Configuration (Google / Facebook Login)</div>
                                                                    <div class="card-body">
                                                                        @if (!string.IsNullOrEmpty(saveOAuthMessage))
                                                                        {
                                                                            <div class="alert alert-success">@saveOAuthMessage</div>
                                                                        }
                                                                        <p class="text-muted">Enter and save the client credentials (Client ID / App ID)
                                                                            below to enable login with Google and Facebook.</p>
                                                                            <form method="post" action="?action=saveoauth">
                                                                                <div class="mb-3">
                                                                                    <label class="form-label">Google Client ID</label>
                                                                                    <input type="text" class="form-control" name="googleClientId"
                                                                                           value="@(AuthKit.Authentication.AuthenticationManager.GoogleClientId)"
                                                                                           placeholder="xxxxxx.apps.googleusercontent.com" />
                                                                                </div>
                                                                                <div class="mb-3">
                                                                                    <label class="form-label">Facebook App ID</label>
                                                                                    <input type="text" class="form-control" name="facebookAppId"
                                                                                           value="@(AuthKit.Authentication.AuthenticationManager.FacebookAppId)"
                                                                                           placeholder="1234567890123456" />
                                                                                </div>
                                                                                <button type="submit" class="btn btn-secondary">Save OAuth Settings</button>
                                                                            </form>
                                                                        </div>
                                                                    </div>

                                                                    <a href="?action=create" class="btn btn-primary btn-lg"
                                                                       onclick="return confirm('9 pages will be created. Do you want to continue?');">
                                                                        Create Pages
                                                                    </a>
                                                                    <p class="text-muted mt-2">Existing pages are skipped.</p>
                                                                }
                                                            </div>
                                                        </div>
                                                    </body>

                                                </html>
