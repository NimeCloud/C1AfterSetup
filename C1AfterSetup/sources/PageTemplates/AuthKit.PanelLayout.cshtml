@inherits RazorPageTemplate
@using System
@using System.Web
@using Composite.Data

@functions {
    public override void Configure()
    {
        TemplateId = new Guid("34df3c70-3c58-454b-8aab-f2259c9b9ca5");
        TemplateTitle = "AuthKit.PanelLayout";
        Layout = null; // Ana layout olduğu için başka bir layout'a bağlı değil
    }

    // Dinamik içeriklerin bu alana yerleşmesini sağlar
    [Placeholder(Id = "content", Title = "Content", IsDefault = true)]
    public XhtmlDocument Content { get; set; }
}

@{
    var tablerIconsUrl = "https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css";
    // Oturum kontrolü - giriş yapılmamışsa login sayfasına yönlendir
    var currentUser = AuthKit.Authentication.AuthenticationManager.GetCurrentUser();
    if (currentUser == null)
    {
        var loginPageId = AuthKit.Authentication.AuthenticationManager.LoginPageId;
        string urlCurrent = HttpContext.Current.Request.Url.AbsoluteUri;
        if (loginPageId != Guid.Empty)
        {
            var loginUrl = AuthKit.C1.C1UrlHelper.GetUrlFromPageId(loginPageId, "~/login");
            Response.Redirect(loginUrl + "?redirect=" + HttpUtility.UrlEncode(urlCurrent));
        }
        else
        {
            Response.Redirect("~/login?redirect=" + HttpUtility.UrlEncode(urlCurrent));
        }
    }
}

<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AuthKit Yönetim Paneli</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.0.2/css/buttons.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/select/2.0.3/css/select.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="@tablerIconsUrl" />

    <style>
            body {
                background-color: #f4f6f9;
                font-family: "Segoe UI", Tahoma, Arial, sans-serif;
            }

            .authkit-navbar {
                background-color: #1f2937;
                color: #fff;
            }

            .authkit-navbar .navbar-brand {
                color: #fff;
                font-weight: 600;
            }

            .authkit-navbar .nav-link {
                color: #cbd5e1;
            }

            .authkit-navbar .nav-link:hover,
            .authkit-navbar .nav-link.active {
                color: #fff;
            }

            .authkit-content {
                padding: 1.5rem;
            }

            .authkit-card {
                background-color: #fff;
                border: 1px solid #e5e7eb;
                border-radius: .5rem;
                box-shadow: 0 1px 3px rgba(0, 0, 0, .08);
            }
    </style>
</head>

<body>
    <nav class="navbar navbar-expand-lg authkit-navbar mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" href="~/">
                <i class="ti ti-shield-lock me-1"></i>AuthKit
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#authkitNav"
                    aria-controls="authkitNav" aria-expanded="false" aria-label="Menüyü aç">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="authkitNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="~/Users">
                            <i class="ti ti-users me-1"></i>Kullanıcılar
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="~/Groups">
                            <i class="ti ti-users-group me-1"></i>Gruplar
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="~/Group-Permissions">
                            <i class="ti ti-shield-check me-1"></i>Grup Yetkileri
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="~/User-Permissions">
                            <i class="ti ti-key me-1"></i>Kullanıcı Yetkileri
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="~/Logout">
                            <i class="ti ti-logout me-1"></i>Çıkış
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid authkit-content">
        <div class="authkit-card p-4">
            @if (Content != null)
            {
                @Markup(Content)
            }
            @RenderBody()
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/select/2.0.3/js/dataTables.select.min.js"></script>
    <script src="https://cdn.datatables.net/editor/2.3.6/js/dataTables.editor.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>

    <script>
        //<![CDATA[
        // Modal kapanınca geride kalan backdrop temizliği
        document.addEventListener('hidden.bs.modal', function () {
        document.querySelectorAll('.modal-backdrop').forEach(function (b) { b.remove(); });
        document.body.classList.remove('modal-open');
        document.body.style.removeProperty('padding-right');
        document.body.style.removeProperty('overflow');
        });
        //]]>
    </script>
</body>

</html>
