@inherits RazorPageTemplate
@using System
@using System.Web
@using Composite.Data

@functions {
    public override void Configure()
    {
        TemplateId = new Guid("34df3c70-3c58-454b-8aab-f2259c9b9ca5");
        TemplateTitle = "AuthKit.PanelLayout";
        Layout = null; // Ana layout olduğu için başka bir layout'a bağlı değil
    }

    // Dinamik içeriklerin bu alana yerleşmesini sağlar
    [Placeholder(Id = "content", Title = "Content", IsDefault = true)]
    public XhtmlDocument Content { get; set; }
}

@{
    // Seed groups/permissions on first admin page visit (idempotent)
    try { AuthKit.Startup.AuthStartupHandler.Initialize(); } catch { }
    var tablerIconsUrl = "https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css";
    // Oturum kontrolü - giriş yapılmamışsa login sayfasına yönlendir
    var currentUser = AuthKit.Authentication.AuthenticationManager.GetCurrentUser();
    // Ensure the current user's admin membership so the first administrator is never locked
    // out (idempotent; safe when the admin group is empty or the C1 user is a C1 Administrator).
    if (currentUser != null)
    {
        try { AuthKit.Authorization.AuthorizationManager.EnsureAdministratorMembership(currentUser.Id); } catch { }
    }
    if (currentUser == null)
    {
        var loginPageId = AuthKit.Authentication.AuthenticationManager.LoginPageId;
        string urlCurrent = HttpContext.Current.Request.Url.AbsoluteUri;
        if (loginPageId != Guid.Empty)
        {
            var loginUrl = AuthKit.C1.C1UrlHelper.GetUrlFromPageId(loginPageId, "~/login");
            Response.Redirect(loginUrl + "?redirect=" + HttpUtility.UrlEncode(urlCurrent));
        }
        else
        {
            Response.Redirect(AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("f6f06000-0000-0000-0000-f6f0f6f0f6f0"), "~/login") +
"?redirect=" + HttpUtility.UrlEncode(urlCurrent));
        }
    }

    // HARDCODED ADMIN GATE: Panel yalnızca System.Administrators grubundaki kullanıcılara açıktır.
    // Admin olmayan (örn. customer) kullanıcılar panel içeriğini/navbar'ı göremez.
    bool isAdmin = false;
    if (currentUser != null)
    {
        try
        {
            isAdmin = AuthKit.Authorization.AuthorizationManager.HasPermission(currentUser,
AuthKit.Authorization.PermissionKeys.Auth.Users.View);
        }
        catch { }
    }
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AuthKit Admin Panel</title>

    <!-- AuthKit local assets: self-contained, no CDN dependency -->
    <link rel="stylesheet" href="~/assets/authkit/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/authkit/bootstrap/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/assets/authkit/datatables/dataTables.buttons.min.css" />
    <link rel="stylesheet" href="~/assets/authkit/datatables/dataTables.select.min.css" />
    <link rel="stylesheet" href="~/assets/authkit/sweetalert2/sweetalert2.min.css" />
    <link rel="stylesheet" href="@tablerIconsUrl" />

    <!-- AuthKit local scripts: loaded in HEAD so child-page scripts see jQuery/DataTables/altEditor -->
    <script src="~/assets/authkit/jquery-3.7.1.min.js"></script>
    <script src="~/assets/authkit/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="~/assets/authkit/datatables/jquery.dataTables.min.js"></script>
    <script src="~/assets/authkit/bootstrap/dataTables.bootstrap5.min.js"></script>
    <script src="~/assets/authkit/datatables/dataTables.buttons.min.js"></script>
    <script src="~/assets/authkit/datatables/buttons.bootstrap5.min.js"></script>
    <script src="~/assets/authkit/datatables/dataTables.select.min.js"></script>
    <script src="~/assets/authkit/datatables/altEditor/dataTables.altEditor.free.js"></script>
    <script src="~/assets/authkit/sweetalert2/sweetalert2.all.min.js"></script>

    <style>
        /* Modal kapanınca geride kalan backdrop temizliği */
        body.modal-open {
        overflow: hidden;
        }
    </style>

    <style>
        body {
        background-color: #f4f6f9;
        font-family: "Segoe UI", Tahoma, Arial, sans-serif;
        }

        .authkit-navbar {
        background-color: #1f2937;
        color: #fff;
        }

        .authkit-navbar .navbar-brand {
        color: #fff;
        font-weight: 600;
        }

        .authkit-navbar .nav-link {
        color: #cbd5e1;
        }

        .authkit-navbar .nav-link:hover,
        .authkit-navbar .nav-link.active {
        color: #fff;
        }

        .authkit-content {
        padding: 1.5rem;
        }

        .authkit-card {
        background-color: #fff;
        border: 1px solid #e5e7eb;
        border-radius: .5rem;
        box-shadow: 0 1px 3px rgba(0, 0, 0, .08);
        }
    </style>
</head>

<body>
    @if (isAdmin)
    {
        <nav class="navbar navbar-expand-lg authkit-navbar mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" href="~/">
                    <i class="ti ti-shield-lock me-1"></i>AuthKit
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#authkitNav"
                        aria-controls="authkitNav" aria-expanded="false" aria-label="Toggle menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="authkitNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link"
                               href="@AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("b2b02000-0000-0000-0000-b2b0b2b0b2b0"), "~/Users")">
                                <i class="ti ti-users me-1"></i>Users
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               href="@AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("c3c03000-0000-0000-0000-c3c0c3c0c3c0"), "~/Groups")">
                                <i class="ti ti-users-group me-1"></i>Groups
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               href="@AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("d4d04000-0000-0000-0000-d4d0d4d0d4d0"), "~/Group-Permissions")">
                                <i class="ti ti-shield-check me-1"></i>Group Permissions
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               href="@AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("e5e05000-0000-0000-0000-e5e0e5e0e5e0"), "~/User-Permissions")">
                                <i class="ti ti-key me-1"></i>User Permissions
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item">
                            <span class="navbar-text text-white-50 me-2"><i class="ti ti-user me-1"></i> @(currentUser !=
                                                            null ? currentUser.UserName : "")</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   href="@AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("d0d0a000-0000-0000-0000-d0d0d0d0d0d0"), "~/Logout")">
                                    <i class="ti ti-logout me-1"></i>Logout
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>

            <div class="container-fluid authkit-content">
                <div class="authkit-card p-4">
                    @if (Content != null)
                    {
                        @Markup(Content)
                    }
                    @RenderBody()
                </div>
            </div>
        }
    else
        {
            <div class="container py-5 text-center">
                <div class="authkit-card p-5 mx-auto" style="max-width: 480px;">
                    <div class="mb-2">
                        <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill px-3 py-2">
                            <i class="ti ti-user me-1"></i> @(currentUser != null ? currentUser.UserName : "")
                        </span>
                    </div>
                    <i class="ti ti-shield-lock text-danger" style="font-size: 3rem;"></i>
                    <h3 class="mt-3 mb-2">Access Denied</h3>
                    <p class="text-muted mb-4">You are signed in, but you do not have permission to access the AuthKit
                        admin panel. Only members of the <strong>System.Administrators</strong> group can use this area.</p>
                        <a href="@AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("d0d0a000-0000-0000-0000-d0d0d0d0d0d0"), "~/Logout")"
                           class="btn btn-outline-secondary w-100 py-2">Sign in with a different account</a>
                    </div>
                </div>
            }
        </body>

    </html>
