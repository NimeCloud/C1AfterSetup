@inherits RazorPageTemplate

@functions {
    public override void Configure()
    {
        TemplateId = new Guid("f9a2e1d7-8c3b-4b2a-9e1f-1a2b3c4d5e6f");
        TemplateTitle = "AuthKit.UserManagementPage";
        Layout = "AuthKit.PanelLayout.cshtml";
    }
}

@{
    var currentUser = AuthKit.Authentication.AuthenticationManager.GetCurrentUser();
    if (currentUser == null)
    {
        var loginPageId = AuthKit.Authentication.AuthenticationManager.LoginPageId;
        string urlCurrent = HttpContext.Current.Request.Url.AbsoluteUri;
        if (loginPageId != Guid.Empty)
        {
            var loginUrl = AuthKit.C1.C1UrlHelper.GetUrlFromPageId(loginPageId, "~/login");
            Response.Redirect(loginUrl + "?redirect=" + HttpUtility.UrlEncode(urlCurrent));
        }
        else
        {
            Response.Redirect(AuthKit.C1.C1UrlHelper.GetUrlFromPageId(
                new Guid("f6f06000-0000-0000-0000-f6f0f6f0f6f0"), "~/login") +
                "?redirect=" + HttpUtility.UrlEncode(urlCurrent));
        }
    }
}

<div>
    <div class="card">
        <ul class="nav nav-pills user-profile-tab" id="pills-tab" role="tablist">
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link position-relative rounded-0 d-flex align-items-center justify-content-center py-3 active"
                    id="pills-real-users-tab" data-bs-toggle="pill" data-bs-target="#pills-real-users" type="button"
                    role="tab">
                    <i class="ti ti-user-circle me-2 fs-6"></i>
                    <span class="d-none d-md-block">Users</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link position-relative rounded-0 d-flex align-items-center justify-content-center py-3"
                    id="pills-template-users-tab" data-bs-toggle="pill" data-bs-target="#pills-template-users"
                    type="button" role="tab">
                    <i class="ti ti-file-text me-2 fs-6"></i>
                    <span class="d-none d-md-block">Template Users</span>
                </button>
            </li>
        </ul>
        <div class="card-body">
            <div class="tab-content" id="pills-tabContent">
                <div class="tab-pane fade active show" id="pills-real-users" role="tabpanel">
                    <p class="card-subtitle mb-4">Manage all users who can log into the system here.
                    </p>
                    <div class="table-responsive">
                        <table id="real-users-table" class="table table-bordered table-striped" style="width:100%">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Username</th>
                                    <th>Email</th>
                                    <th>Active</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
                <div class="tab-pane fade" id="pills-template-users" role="tabpanel">
                    <p class="card-subtitle mb-4">Manage template accounts for new users here.</p>
                    <div class="table-responsive">
                        <table id="template-users-table" class="table table-bordered table-striped" style="width:100%">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Username</th>
                                    <th>Email</th>
                                    <th>Active</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Tab styling: inactive tabs get a visible background + border so they don't blend into
       the white card; the active tab stands out in blue. */
    .user-profile-tab .nav-link {
        background-color: #f1f3f5;
        color: #495057;
        border: 1px solid #dee2e6;
        font-size: 1.05rem;
    }

    .user-profile-tab .nav-link i {
        font-size: 1rem;
    }

    .user-profile-tab .nav-link:hover {
        background-color: #e2e6ea;
        color: #212529;
    }

    .user-profile-tab .nav-link.active,
    .user-profile-tab .nav-link.active:hover {
        background-color: #0d6efd;
        border-color: #0d6efd;
        color: #fff;
    }

    .user-profile-tab .nav-link.active i {
        color: #fff;
    }

    .dataTables_wrapper .dataTables_info,
    .dataTables_wrapper .dataTables_paginate {
        margin-top: 1.5rem;
        padding-bottom: 0.5rem;
    }

    .dt-button-divider,
    .dt-buttons .dt-button.dt-button-divider:hover {
        background: transparent !important;
        padding: 0 !important;
        width: 0 !important;
        border: none !important;
        border-left: 1px solid rgba(0, 0, 0, 0.15);
        border-right: 1px solid rgba(255, 255, 255, 0.7);
        margin: 0 0.5em !important;
        cursor: default;
        box-shadow: none !important;
    }
</style>

<script>
    //<![CDATA[
    // AuthKit User Management — uses free altEditor (DataTables altEditor plugin), NOT commercial
    // DataTables Editor. jQuery/DataTables/altEditor/SweetAlert2 are loaded in AuthKit.PanelLayout <head>.

    // Suppress DataTables' default alert/console Ajax-error popups; errors are handled below.
    $.fn.dataTable.ext.errMode = 'none';

    // Replaces DataTables' "Loading..." row with a readable message when the API returns
    // 401/403 (auth/permission) or any other non-200 response.
    function showTableLoadError(tableId, xhr) {
        var msg = 'An error occurred while loading the table.';
        if (xhr && xhr.responseJSON && xhr.responseJSON.error) msg = xhr.responseJSON.error;
        else if (xhr && xhr.responseText) {
            try { var j = JSON.parse(xhr.responseText); if (j && j.error) msg = j.error; } catch (e) { }
        }
        if (xhr && (xhr.status === 401 || xhr.status === 403)) {
            if (!window.__authkitAuthErrorShown) {
                window.__authkitAuthErrorShown = true;
                Swal.fire('Permission Error', msg, 'error');
            }
        }
        $('#' + tableId).find('tbody').empty()
            .append('<tr><td colspan="99" class="text-center text-danger py-4">' + msg + '</td></tr>');
    }

    function initializeDataTable(tableId, apiUrl, isTemplateTable) {
        var columns = [
            { "data": "Id" }, { "data": "UserName" }, { "data": "Email" }, { "data": "IsActive" }
        ];

        var buttons = [
            { text: 'Add', name: 'add' },
            { extend: 'selected', text: 'Edit', name: 'edit' },
            { extend: 'selected', text: 'Delete', name: 'delete' }
        ];

        if (!isTemplateTable) {
            buttons.push({ className: 'dt-button-divider', text: '', action: function (e) { e.preventDefault(); } });
            buttons.push({
                text: 'Change Password',
                action: function (e, dt, node, config) {
                    var selectedData = dt.rows({ selected: true }).data()[0];
                    if (!selectedData) { Swal.fire('Info', 'Please select a user first.', 'info'); return; }
                    Swal.fire({
                        title: 'New password for ' + selectedData.UserName,
                        html: '<input type="password" id="swal-input-password" class="swal2-input" placeholder="New Password">' +
                            '<input type="password" id="swal-input-confirm" class="swal2-input" placeholder="Confirm Password">',
                        focusConfirm: false,
                        preConfirm: function () {
                            var p1 = document.getElementById('swal-input-password').value;
                            var p2 = document.getElementById('swal-input-confirm').value;
                            if (!p1 || !p2) { Swal.showValidationMessage('Please fill in both fields.'); return false; }
                            if (p1 !== p2) { Swal.showValidationMessage('Passwords do not match!'); return false; }
                            return { newPassword: p1 };
                        }
                    }).then(function (result) {
                        if (result.isConfirmed) {
                            $.ajax({
                                url: '/Api/AdminChangePassword', type: 'POST', contentType: 'text/plain; charset=utf-8',
                                data: JSON.stringify({ userId: selectedData.Id, newPassword: result.value.newPassword }),
                                success: function () { Swal.fire('Success!', 'User password updated.', 'success'); },
                                error: function (res) { var err = res.responseJSON; Swal.fire('Error!', err.error || 'An error occurred.', 'error'); }
                            });
                        }
                    });
                }
            });
            buttons.push({
                text: 'Manage Groups',
                action: function (e, dt, node, config) {
                    var selectedData = dt.rows({ selected: true }).data()[0];
                    if (!selectedData) { Swal.fire('Info', 'Please select a user first.', 'info'); return; }
                    openUserGroupManagementModal(selectedData.Id, selectedData.UserName);
                }
            });
        }

        $('#' + tableId).DataTable({
            "ajax": {
                "url": apiUrl, "type": "POST", "contentType": "text/plain; charset=utf-8",
                "data": function (d) { return JSON.stringify({}); }, "dataSrc": "data",
                "error": function (xhr) { showTableLoadError(tableId, xhr); }
            },
            "columns": columns,
            "dom": 'Bfrtip',
            "select": 'single',
            "responsive": true,
            "altEditor": true,
            "buttons": buttons,
            "columnDefs": [
                { "targets": 0, "visible": false, "readonly": true },
                { "targets": 1, "title": isTemplateTable ? "Template Name" : "Username" },
                { "targets": 2, "title": "Email", "type": "email" },
                {
                    "targets": 3, "title": "Active", "type": "checkbox", "inlineLabel": false,
                    "render": function (data, type) { return type === 'display' ? '<div class="form-check d-flex justify-content-center"><input class="form-check-input" type="checkbox"' + (data ? ' checked' : '') + ' disabled></div>' : data; }
                }
            ],
            "onAddRow": function (datatable, rowdata, success, error) {
                rowdata.IsTemplate = isTemplateTable;
                if (!isTemplateTable) {
                    var sourceUserId = $('#alteditor-clone-user-select').val();
                    if (sourceUserId) { rowdata.SourceUserId = sourceUserId; }
                }
                $.ajax({
                    url: '/Api/AddUser', type: 'POST', contentType: 'text/plain; charset=utf-8', data: JSON.stringify(rowdata),
                    success: function (data) { success(data); Swal.fire('Success!', 'User added.', 'success'); },
                    error: function (res) { var err = res.responseJSON || { error: 'There was a problem processing the request.' }; Swal.fire('Error!', err.error, 'error'); }
                });
            },
            "onEditRow": function (datatable, rowdata, success, error) {
                $.ajax({
                    url: '/Api/UpdateUser', type: 'POST', contentType: 'text/plain; charset=utf-8', data: JSON.stringify(rowdata),
                    success: function (data) { success(data); Swal.fire('Success!', 'User updated.', 'success'); },
                    error: function (res) { var err = res.responseJSON || { error: 'There was a problem processing the request.' }; Swal.fire('Error!', err.error, 'error'); }
                });
            },
            "onDeleteRow": function (datatable, rowdata, success, error) {
                $.ajax({
                    url: '/Api/DeleteUser', type: 'POST', contentType: 'text/plain; charset=utf-8', data: JSON.stringify(rowdata[0]),
                    success: function (data) { success(data); Swal.fire('Success!', 'User deleted.', 'success'); },
                    error: function (res) { var err = res.responseJSON || { error: 'There was a problem processing the request.' }; Swal.fire('Error!', err.error, 'error'); }
                });
            }
        });
    }

    $(function () {
        initializeDataTable('real-users-table', '/Api/GetRealUsers', false);
        initializeDataTable('template-users-table', '/Api/GetTemplateUsers', true);

        $('button[data-bs-toggle="pill"]').on('shown.bs.tab', function (e) {
            $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
        });
    });

    // AltEditor modal düzenlemeleri
    $(function () {
        $(document).on('alteditor:add_dialog_opened', '.altEditor-modal', function () {
            var modalBody = $(this).find('.modal-body');
            var isTemplateTabActive = $('#pills-template-users-tab').hasClass('active');
            $(this).find('#alteditor-row-Id').hide();
            if (isTemplateTabActive) {
                $('#alteditor-row-IsActive, #alteditor-row-IsTemplate, #alteditor-row-PasswordHash').hide();
            } else {
                $('#PasswordHash').attr('placeholder', 'Can be left blank...');
                var cloneRow = $('<div class="mb-3 row" id="alteditor-clone-user-row" style="display:none;"><label class="col-md-4">Clone from Template</label><div class="col-md-8"><select id="alteditor-clone-user-select" class="form-select"><option value="">Copy...</option></select></div></div>');
                modalBody.append(cloneRow);
                $.ajax({
                    url: '/Api/GetTemplateUsers', type: 'POST', contentType: 'text/plain; charset=utf-8',
                    success: function (response) {
                        if (response.data && response.data.length > 0) {
                            var select = $('#alteditor-clone-user-select');
                            response.data.forEach(function (user) { select.append(new Option(user.UserName, user.Id)); });
                            cloneRow.show();
                        }
                    }
                });
            }
        });

        $(document).on('alteditor:edit_dialog_opened', '.altEditor-modal', function () {
            $(this).find('#alteditor-row-Id').hide();
            var rowData = $('#real-users-table, #template-users-table').DataTable().rows({ selected: true }).data()[0];
            var isTemplate = rowData && rowData.IsTemplate;
            if (isTemplate) {
                $('#alteditor-row-IsActive, #alteditor-row-IsTemplate, #alteditor-row-PasswordHash').hide();
            } else {
                $('#PasswordHash').attr('placeholder', 'Fill in to change');
                $('#alteditor-row-IsTemplate').hide();
            }
        });
    });

    function openUserGroupManagementModal(userId, userName) {
        var changes = { added: new Set(), removed: new Set() };
        var initialMemberIds = new Set();
        var modalInstance, table;
        var forceClose = false;

        // First, fetch the user's current group memberships.
        // The modal + DataTable are created INSIDE the success callback so
        // initialMemberIds is always populated before the table renders.
        $.ajax({
            url: '/Api/GetAllGroupIdsForUser', type: 'POST', contentType: 'text/plain; charset=utf-8',
            data: JSON.stringify({ userId: userId }),
            success: function (response) {
                if (response.data) {
                    response.data.forEach(function (id) { initialMemberIds.add(id.toString()); });
                }

                var modalHtml = '<div class="modal fade" id="userGroupsModal" tabindex="-1">' +
                    '<div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">' +
                    '<div class="modal-header"><h5 class="modal-title">' + userName + ' - Group Memberships</h5>' +
                    '<button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>' +
                    '<div class="modal-body"><table id="groups-for-user-table" class="table table-bordered" style="width:100%">' +
                    '<thead><tr><th></th><th>Group Name</th><th>Description</th><th></th></tr></thead><tbody></tbody></table></div>' +
                    '<div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>' +
                    '<button type="button" class="btn btn-primary" id="saveUserGroupsBtn">Save</button></div></div></div></div>';

                $('#userGroupsModal').remove();
                $('body').append(modalHtml);
                modalInstance = new bootstrap.Modal(document.getElementById('userGroupsModal'));
                modalInstance.show();

                table = $('#groups-for-user-table').DataTable({
                    serverSide: true,
                    ajax: {
                        url: '/Api/GetAllGroupsForUserManagement', type: 'POST', contentType: 'text/plain; charset=utf-8',
                        data: function (d) { return JSON.stringify({ UserId: userId, DtRequest: d }); },
                        error: function (xhr) { showTableLoadError('groups-for-user-table', xhr); }
                    },
                    columns: [
                        {
                            data: 'id', orderable: false, render: function (d, type, row) {
                                var gid = row.id ? row.id.toString() : (d ? d.toString() : '');
                                var isSelected = (initialMemberIds.has(gid) && !changes.removed.has(gid)) || changes.added.has(gid);
                                return '<input type="checkbox" class="form-check-input dt-checkbox" value="' + gid + '"' + (isSelected ? ' checked' : '') + '>';
                            }
                        },
                        { data: 'groupName' }, { data: 'description' },
                        {
                            data: null, orderable: false,
                            render: function (data, type, row) {
                                var gid = row.id ? row.id.toString() : '';
                                var isMember = (initialMemberIds.has(gid) && !changes.removed.has(gid)) || changes.added.has(gid);
                                if (isMember) {
                                    return '<button class="btn btn-sm btn-outline-danger leave-group-btn" data-gid="' + gid + '">Leave</button>';
                                } else {
                                    return '<button class="btn btn-sm btn-outline-success join-group-btn" data-gid="' + gid + '">Join</button>';
                                }
                            }
                        }
                    ],
                    drawCallback: function () {
                        var api = this.api();
                        api.rows({ page: 'current' }).nodes().each(function (node, index) {
                            var rowData = api.row(index).data();
                            if (rowData) {
                                var gid = rowData.id ? rowData.id.toString() : '';
                                var isSelected = (initialMemberIds.has(gid) && !changes.removed.has(gid)) || changes.added.has(gid);
                                $(node).toggleClass('table-success', isSelected);
                                $(node).find('.dt-checkbox').prop('checked', isSelected);
                            }
                        });
                    }
                });

                // Per-row Join/Leave buttons (instant, no Save needed)
                $('#groups-for-user-table tbody').on('click', '.join-group-btn', function () {
                    var gid = $(this).data('gid');
                    changes.added.add(gid);
                    changes.removed.delete(gid);
                    table.ajax.reload(null, false);
                });
                $('#groups-for-user-table tbody').on('click', '.leave-group-btn', function () {
                    var gid = $(this).data('gid');
                    changes.removed.add(gid);
                    changes.added.delete(gid);
                    table.ajax.reload(null, false);
                });

                $('#groups-for-user-table tbody').on('change', '.dt-checkbox', function () {
                    var gid = $(this).val();
                    var isChecked = this.checked;
                    $(this).closest('tr').toggleClass('table-success', isChecked);
                    if (initialMemberIds.has(gid)) {
                        if (!isChecked) { changes.removed.add(gid); changes.added.delete(gid); }
                        else { changes.removed.delete(gid); }
                    } else {
                        if (isChecked) { changes.added.add(gid); changes.removed.delete(gid); }
                        else { changes.added.delete(gid); }
                    }
                });

                $('#saveUserGroupsBtn').on('click', function () {
                    var btn = $(this);
                    btn.prop('disabled', true);
                    $.ajax({
                        url: '/Api/UpdateUserGroupsDelta', type: 'POST', contentType: 'text/plain; charset=utf-8',
                        data: JSON.stringify({ userId: userId, groupIdsToAdd: Array.from(changes.added), groupIdsToRemove: Array.from(changes.removed) }),
                        success: function () { forceClose = true; modalInstance.hide(); Swal.fire('Success!', 'Group memberships updated.', 'success'); },
                        error: function () { Swal.fire('Error!', 'Update failed.', 'error'); },
                        complete: function () { btn.prop('disabled', false); }
                    });
                });

                $('#userGroupsModal').on('hidden.bs.modal', function () { $(this).remove(); if (table) table.destroy(); });
            },
            error: function () {
                Swal.fire('Error!', 'Failed to load group memberships.', 'error');
            }
        });
    }
    //]]>
</script>
