@inherits RazorPageTemplate

@functions {
    public override void Configure()
    {
        TemplateId = new Guid("50562763-9421-40b6-8897-5214ab170051");
        TemplateTitle = "AuthKit.GroupManagementPage";
        Layout = "AuthKit.PanelLayout.cshtml";
    }
}

@{
    var currentUser = AuthKit.Authentication.AuthenticationManager.GetCurrentUser();
    if (currentUser == null)
    {
        var loginPageId = AuthKit.Authentication.AuthenticationManager.LoginPageId;
        string urlCurrent = HttpContext.Current.Request.Url.AbsoluteUri;
        if (loginPageId != Guid.Empty)
        {
            Response.Redirect(AuthKit.C1.C1UrlHelper.GetUrlFromPageId(loginPageId, "~/login") + "?redirect=" +
                HttpUtility.UrlEncode(urlCurrent));
        }
        else
        {
            Response.Redirect(AuthKit.C1.C1UrlHelper.GetUrlFromPageId(
                new Guid("f6f06000-0000-0000-0000-f6f0f6f0f6f0"), "~/login") +
                "?redirect=" + HttpUtility.UrlEncode(urlCurrent));
        }
    }
}

<div>
    @* CSS: DataTables, PanelLayout icerisinde CDN ile yuklenir *@

    <div class="card">
        <div class="card-body">
            <p class="card-subtitle mb-4">Sistemdeki tüm kullanıcı gruplarını buradan yönetebilirsiniz.</p>
            <div class="table-responsive mt-4">
                <table id="groups-table" class="table table-bordered table-striped" style="width:100%">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Grup Adı</th>
                            <th>Açıklama</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    //<![CDATA[
    // AuthKit Group Management — uses free altEditor (DataTables altEditor plugin), NOT commercial
    // DataTables Editor. jQuery/DataTables/altEditor/SweetAlert2 are loaded in AuthKit.PanelLayout <head>.

    // Suppress DataTables' default alert/console Ajax-error popups; errors are handled below.
    $.fn.dataTable.ext.errMode = 'none';

    // Replaces DataTables' "Loading..." row with a readable message when the API returns
    // 401/403 (auth/permission) or any other non-200 response.
    function showTableLoadError(tableId, xhr) {
        var msg = 'Tablo yüklenirken bir hata oluştu.';
        if (xhr && xhr.responseJSON && xhr.responseJSON.error) msg = xhr.responseJSON.error;
        else if (xhr && xhr.responseText) {
            try { var j = JSON.parse(xhr.responseText); if (j && j.error) msg = j.error; } catch (e) { }
        }
        if (xhr && (xhr.status === 401 || xhr.status === 403)) {
            if (!window.__authkitAuthErrorShown) {
                window.__authkitAuthErrorShown = true;
                Swal.fire('Yetki Hatası', msg, 'error');
            }
        }
        $('#' + tableId).find('tbody').empty()
            .append('<tr><td colspan="99" class="text-center text-danger py-4">' + msg + '</td></tr>');
    }

    $(function () {
        var buttons = [
            { text: 'Ekle', name: 'add' },
            { extend: 'selected', text: 'Düzenle', name: 'edit' },
            { extend: 'selected', text: 'Sil', name: 'delete' },
            { className: 'dt-button-divider', text: '', action: function (e) { e.preventDefault(); } },
            {
                extend: 'selected', text: 'Üyeleri Yönet',
                action: function (e, dt, node, config) {
                    var selectedData = dt.rows({ selected: true }).data()[0];
                    if (selectedData) openGroupUserManagementModal(selectedData.Id, selectedData.GroupName);
                }
            }
        ];

        $('#groups-table').DataTable({
            dom: 'Bfrtip',
            select: 'single',
            altEditor: true,
            ajax: {
                url: '/Api/GetGroups', type: 'POST', contentType: 'text/plain; charset=utf-8', data: function (d) { return JSON.stringify({}); }, dataSrc: 'data',
                error: function (xhr) { showTableLoadError('groups-table', xhr); }
            },
            columns: [
                { data: 'Id', visible: false },
                { data: 'GroupName', title: 'Grup Adı' },
                { data: 'Description', title: 'Açıklama' }
            ],
            buttons: buttons,
            "onAddRow": function (datatable, rowdata, success, error) {
                var sourceGroupId = $('#alteditor-clone-group-select').val();
                if (sourceGroupId) { rowdata.SourceGroupId = sourceGroupId; }
                $.ajax({
                    url: '/Api/AddGroup', type: 'POST', contentType: 'text/plain; charset=utf-8', data: JSON.stringify(rowdata),
                    success: function (data) { success(data); Swal.fire('Başarılı!', 'Grup eklendi.', 'success'); },
                    error: function (res) { var err = res.responseJSON || { error: 'İstek işlenirken bir sorun oluştu.' }; Swal.fire('Hata!', err.error, 'error'); }
                });
            },
            "onEditRow": function (datatable, rowdata, success, error) {
                $.ajax({
                    url: '/Api/UpdateGroup', type: 'POST', contentType: 'text/plain; charset=utf-8', data: JSON.stringify(rowdata),
                    success: function (data) { success(data); Swal.fire('Başarılı!', 'Grup güncellendi.', 'success'); },
                    error: function (res) { var err = res.responseJSON || { error: 'İstek işlenirken bir sorun oluştu.' }; Swal.fire('Hata!', err.error, 'error'); }
                });
            },
            "onDeleteRow": function (datatable, rowdata, success, error) {
                $.ajax({
                    url: '/Api/DeleteGroup', type: 'POST', contentType: 'text/plain; charset=utf-8', data: JSON.stringify(rowdata[0]),
                    success: function (data) { success(data); Swal.fire('Başarılı!', 'Grup silindi.', 'success'); },
                    error: function (res) { var err = res.responseJSON || { error: 'İstek işlenirken bir sorun oluştu.' }; Swal.fire('Hata!', err.error, 'error'); }
                });
            }
        });

        // AltEditor modal düzenlemeleri: klonlama dropdown'i
        $(document).on('alteditor:add_dialog_opened', '.altEditor-modal', function () {
            var modalBody = $(this).find('.modal-body');
            $(this).find('#alteditor-row-Id').hide();
            if ($('#alteditor-clone-group-row').length === 0) {
                var cloneRow = $('<div class="mb-3 row" id="alteditor-clone-group-row"><label class="col-md-4">Yetkileri Kopyala</label><div class="col-md-8"><select id="alteditor-clone-group-select" class="form-select"><option value="">Kopyalama...</option></select></div></div>');
                modalBody.append(cloneRow);
                $.ajax({
                    url: '/Api/GetAllGroupsForDropdown', type: 'POST',
                    success: function (r) {
                        if (r.data) r.data.forEach(function (g) { $('#alteditor-clone-group-select').append(new Option(g.GroupName, g.Id)); });
                    }
                });
            }
        });

        // Uye yonetim modal'i
        function openGroupUserManagementModal(groupId, groupName) {
            var changes = { added: new Set(), removed: new Set() };
            var initialMemberIds = new Set();
            var modalInstance, table;

            $.ajax({
                url: '/Api/GetAllUserIdsForGroup', type: 'POST', contentType: 'text/plain; charset=utf-8',
                data: JSON.stringify({ groupId: groupId }),
                success: function (r) { if (r.data) r.data.forEach(function (id) { initialMemberIds.add(id.toString()); }); }
            });

            var mh = '<div class="modal fade" id="groupUsersModal" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content">' +
                '<div class="modal-header"><h5 class="modal-title">' + groupName + ' Grubu Üyeleri</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>' +
                '<div class="modal-body"><table id="users-for-group-table" class="table table-bordered" style="width:100%"><thead><tr><th></th><th>Kullanıcı</th><th>E-posta</th></tr></thead></table></div>' +
                '<div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button><button class="btn btn-primary" id="saveGroupMembersBtn">Kaydet</button></div></div></div></div>';

            $('#groupUsersModal').remove();
            $('body').append(mh);
            modalInstance = new bootstrap.Modal(document.getElementById('groupUsersModal'));
            modalInstance.show();

            table = $('#users-for-group-table').DataTable({
                ajax: {
                    url: '/Api/GetUsersForGroupManagement', type: 'POST', contentType: 'text/plain; charset=utf-8',
                    data: function (d) { return JSON.stringify({ GroupId: groupId, DtRequest: d }); },
                    error: function (xhr) { showTableLoadError('users-for-group-table', xhr); }
                },
                columns: [
                    { data: 'id', orderable: false, render: function (d) { return '<input type="checkbox" class="dt-checkbox" value="' + d + '">'; } },
                    { data: 'userName' }, { data: 'email' }
                ],
                drawCallback: function () {
                    $('#users-for-group-table tbody input.dt-checkbox').each(function () {
                        var uid = $(this).val();
                        $(this).prop('checked', (initialMemberIds.has(uid) && !changes.removed.has(uid)) || changes.added.has(uid));
                    });
                }
            });

            $('#users-for-group-table tbody').on('change', '.dt-checkbox', function () {
                var uid = $(this).val(), checked = this.checked;
                if (initialMemberIds.has(uid)) { checked ? changes.removed.delete(uid) : changes.removed.add(uid); changes.added.delete(uid); }
                else { checked ? changes.added.add(uid) : changes.added.delete(uid); }
            });

            $('#saveGroupMembersBtn').on('click', function () {
                $.ajax({
                    url: '/Api/UpdateGroupMembersDelta', type: 'POST', contentType: 'text/plain; charset=utf-8',
                    data: JSON.stringify({ groupId: groupId, userIdsToAdd: Array.from(changes.added), userIdsToRemove: Array.from(changes.removed) }),
                    success: function () { modalInstance.hide(); Swal.fire('Başarılı!', 'Üyeler güncellendi.', 'success'); },
                    error: function () { Swal.fire('Hata!', 'Güncelleme başarısız.', 'error'); }
                });
            });

            $('#groupUsersModal').on('hidden.bs.modal', function () { $(this).remove(); if (table) table.destroy(); });
        }
    });
    //]]>
</script>
