@inherits RazorFunction
@*
    AuthKit Page Setup Assistant
    ============================
    Add this Razor function to any C1 page and run it to
    automatically add the AuthKit admin pages to your C1 page tree.

    How to run: navigate to /page(your-page-id) and view the page where this function is added.
    After it runs, you can remove this function from the page.

    Security: Only users in the C1 Administrator group can run it.
*@

@using Composite.Data
@using Composite.Data.Types
@using System
@using System.Linq

@{
    // OTOMATIK BASLATMA: AuthKit henuz initialize edilmediyse simdi yap
    if (!AuthKit.Startup.AuthStartupHandler.IsInitialized)
    {
        try
        {
            AuthKit.Startup.AuthStartupHandler.Initialize();
        }
        catch (Exception ex)
        {
            <div class="alert alert-danger">AuthKit startup error: @ex.Message</div>
            return;
        }
    }

    // Guvenlik kontrolu
    if (!AuthKit.C1.C1Security.IsCurrentUserInAdministratorsGroup())
    {
        <div class="alert alert-danger">This operation can only be performed by C1 Administrators.</div>
        return;
    }

    var action = Request.QueryString["action"];
    var result = "";

    if (action == "create")
    {
        result = CreateAuthPages();
    }
}

<!DOCTYPE html>
<html>

<head>
    <title>AuthKit Page Setup</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>

<body class="p-4">
    <div class="container">
        <h2>AuthKit Page Setup</h2>

        @if (!string.IsNullOrEmpty(result))
        {
            <div class="alert alert-info">
                <pre>@result</pre>
            </div>
        }

        <div class="card mb-3">
            <div class="card-header">Pages to Create</div>
            <div class="card-body">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Page</th>
                            <th>URL</th>
                            <th>Template</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>User Management</td>
                            <td>/Users</td>
                            <td>AuthKit.UserManagementPage</td>
                        </tr>
                        <tr>
                            <td>Group Management</td>
                            <td>/Groups</td>
                            <td>AuthKit.GroupManagementPage</td>
                        </tr>
                        <tr>
                            <td>Group Permissions</td>
                            <td>/Group-Permissions</td>
                            <td>AuthKit.GroupPermissionPage</td>
                        </tr>
                        <tr>
                            <td>User Permissions</td>
                            <td>/User-Permissions</td>
                            <td>AuthKit.UserPermissionPage</td>
                        </tr>
                        <tr>
                            <td>Log In</td>
                            <td>/Login</td>
                            <td>AuthKit.AuthLayout (Razor: Login)</td>
                        </tr>
                        <tr>
                            <td>Sign Up</td>
                            <td>/Register</td>
                            <td>AuthKit.AuthLayout (Razor: Register)</td>
                        </tr>
                        <tr>
                            <td>Forgot Password</td>
                            <td>/Forgot-Password</td>
                            <td>AuthKit.AuthLayout (Razor: ForgotPassword)</td>
                        </tr>
                        <tr>
                            <td>Reset Password</td>
                            <td>/Reset-Password</td>
                            <td>AuthKit.AuthLayout (Razor: ResetPassword)</td>
                        </tr>
                        <tr>
                            <td>Log Out</td>
                            <td>/Logout</td>
                            <td>AuthKit.AuthLayout (Razor: Logout)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <a href="?action=create" class="btn btn-primary btn-lg"
           onclick="return confirm('Pages will be created. Do you want to continue?');">
            Create Pages
        </a>
        <p class="text-muted mt-2">Existing pages are skipped; only missing ones are added.</p>
    </div>
</body>

</html>

@functions {
    // PageTypeId: C1 CMS'in varsayilan Page Type'i
    private static readonly Guid DefaultPageTypeId = new Guid("f7869eb2-7369-4eb2-af47-e3be261e92c7");

    // AuthLayout template GUID'i (AuthLayout.cshtml icindeki TemplateId)
    private static readonly Guid AuthLayoutTemplateId = new Guid("24e07eb6-17c9-424e-9c16-219f57a85900");

    private static readonly Guid RootPageId = new Guid("00000000-0000-0000-0000-000000000000");

    public static string CreateAuthPages()
    {
        var log = new System.Text.StringBuilder();
        using (var conn = new DataConnection())
        {
            // Sayfa tanimlari: (TemplateId, Title, UrlTitle, MenuTitle)
            var pagesToCreate = new[] {
                // Admin pages
                (TemplateId: new Guid("f9a2e1d7-8c3b-4b2a-9e1f-1a2b3c4d5e6f"), Title: "Users", UrlTitle: "Users", MenuTitle:
"Users"),
                (TemplateId: new Guid("50562763-9421-40b6-8897-5214ab170051"), Title: "Groups", UrlTitle: "Groups", MenuTitle:
"Groups"),
                (TemplateId: new Guid("ff5a0c90-7f64-4e56-b9b9-1c078276f4c2"), Title: "Group Permissions", UrlTitle:
"Group-Permissions", MenuTitle: "Group Permissions"),
                (TemplateId: new Guid("70d2e0d8-d2d1-4209-a5ae-a0bc7d283a9d"), Title: "User Permissions", UrlTitle: "User-Permissions",
MenuTitle: "User Permissions"),
                // Auth pages
                (TemplateId: AuthLayoutTemplateId, Title: "Login", UrlTitle: "Login", MenuTitle: "Login"),
                (TemplateId: AuthLayoutTemplateId, Title: "Register", UrlTitle: "Register", MenuTitle: "Register"),
                (TemplateId: AuthLayoutTemplateId, Title: "Forgot Password", UrlTitle: "Forgot-Password", MenuTitle: "Forgot Password"),
                (TemplateId: AuthLayoutTemplateId, Title: "Reset Password", UrlTitle: "Reset-Password", MenuTitle: "Reset Password"),
                (TemplateId: AuthLayoutTemplateId, Title: "Logout", UrlTitle: "Logout", MenuTitle: "Logout"),
            };

            foreach (var page in pagesToCreate)
            {
                // Ayni URL'de sayfa var mi kontrol et
                var existing = conn.Get<IPage>().FirstOrDefault(p => p.UrlTitle == page.UrlTitle);
                if (existing != null)
                {
                    log.AppendLine($"SKIPPED: '{page.Title}' already exists (ID: {existing.Id})");
                    continue;
                }

                try
                {
                    // Yeni sayfa olustur
                    var newPage = conn.CreateNew<IPage>();
                    newPage.Id = Guid.NewGuid();
                    newPage.TemplateId = page.TemplateId;
                    newPage.PageTypeId = DefaultPageTypeId;
                    newPage.Title = page.Title;
                    newPage.MenuTitle = page.MenuTitle;
                    newPage.UrlTitle = page.UrlTitle;
                    newPage.FriendlyUrl = "";
                    newPage.Description = "";
                    newPage.SourceCultureName = "tr-TR";
                    newPage.PublicationStatus = "published";
                    newPage.CreationDate = DateTime.Now;
                    newPage.ChangeDate = DateTime.Now;
                    newPage.ChangedBy = "admin";
                    newPage.CreatedBy = "admin";
                    newPage.VersionId = Guid.NewGuid();
                    conn.Add(newPage);

                    // Sayfa yapisina ekle (kok seviyesinde)
                    var structure = conn.CreateNew<IPageStructure>();
                    structure.Id = newPage.Id;
                    structure.ParentId = RootPageId;
                    structure.LocalOrdering = 99;
                    conn.Add(structure);

                    log.AppendLine($"CREATED: '{page.Title}' -> /{page.UrlTitle} (ID: {newPage.Id})");

                    // Login sayfasinin GUID'ini AuthKit'e bildir
                    if (page.UrlTitle == "Login")
                    {
                        AuthKit.Authentication.AuthenticationManager.LoginPageId = newPage.Id;
                        log.AppendLine($"  -> LoginPageId set: {newPage.Id}");
                    }

                    // Reset Password sayfasinin GUID'ini AuthKit'e bildir
                    if (page.UrlTitle == "Reset-Password")
                    {
                        AuthKit.Authentication.AuthenticationManager.ResetPasswordPageId = newPage.Id;
                        log.AppendLine($"  -> ResetPasswordPageId set: {newPage.Id}");
                    }
                }
                catch (Exception ex)
                {
                    log.AppendLine($"ERROR: '{page.Title}' could not be created: {ex.Message}");
                }
            }

            // Login sayfa GUID'lerini Settings'e kaydet (kalici olsun)
            if (AuthKit.Authentication.AuthenticationManager.LoginPageId != Guid.Empty)
                KeyTreeStoreKit.KeyTreeStoreManager.Set("Auth.LoginPageId",
AuthKit.Authentication.AuthenticationManager.LoginPageId.ToString());

            if (AuthKit.Authentication.AuthenticationManager.ResetPasswordPageId != Guid.Empty)
                KeyTreeStoreKit.KeyTreeStoreManager.Set("Auth.ResetPasswordPageId",
AuthKit.Authentication.AuthenticationManager.ResetPasswordPageId.ToString());
        }

        return log.ToString();
    }
}
