@inherits RazorFunction
@using System

@functions {
    public override string FunctionDescription => "AuthKit registration form";
}

@{
    var error = "";
    var success = false;
    if (IsPost)
    {
        var username = Request.Form["username"];
        var email = Request.Form["email"];
        var password = Request.Form["password"];
        var confirm = Request.Form["confirm"];
        if (password != confirm)
        {
            error = "Passwords do not match.";
        }
        else
        {
            var result = AuthKit.Authentication.AuthenticationManager.CreateUser(username, email, password, true, false);
            if (result.IsSuccess)
            {
                success = true;
            }
            else
            {
                error = result.ErrorMessage;
            }
        }
    }
}

<h4 class="mb-1 fw-semibold">Sign Up</h4>
<p class="mb-3 text-muted">Create a new account</p>

@if (success)
{
    <div class="alert alert-success py-2">Your account has been created. You can now log in.</div>
    <a class="btn btn-primary w-100"
       href="@AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("f6f06000-0000-0000-0000-f6f0f6f0f6f0"), "~/Login")">Log
        In</a>
    }

    @if (!success)
    {
        if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger py-2">@error</div>
        }
        <form method="post">
            <div class="mb-3">
                <label class="form-label">Username</label>
                <input type="text" class="form-control" name="username" required="required" />
            </div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" name="email" required="required" />
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" class="form-control" name="password" required="required" />
            </div>
            <div class="mb-3">
                <label class="form-label">Password (Repeat)</label>
                <input type="password" class="form-control" name="confirm" required="required" />
            </div>
            <button type="submit" class="btn btn-primary w-100">Sign Up</button>
            <div class="text-center mt-3 small">
                <a href="@AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("f6f06000-0000-0000-0000-f6f0f6f0f6f0"), "~/Login")">Already
                    have an account? Log in</a>
                </div>
            </form>
        }
