@inherits RazorFunction
@using System

@functions {
    public override string FunctionDescription => "AuthKit password reset form";
}

@{
    var token = Request.QueryString["token"];
    var error = "";
    var success = false;
    if (string.IsNullOrEmpty(token))
    {
        error = "Invalid or missing reset token.";
    }
    else if (IsPost)
    {
        var password = Request.Form["password"];
        var confirm = Request.Form["confirm"];
        if (password != confirm)
        {
            error = "Passwords do not match.";
        }
        else
        {
            var result = AuthKit.Authentication.AuthenticationManager.ResetPassword(token, password);
            var dict = new System.Web.Script.Serialization.JavaScriptSerializer().DeserializeObject(result) as
System.Collections.Generic.Dictionary<string, object>;
            var ok = dict != null && dict.ContainsKey("ok") && Convert.ToBoolean(dict["ok"]);
            if (ok)
            {
                success = true;
            }
            else
            {
                error = (dict != null && dict.ContainsKey("error")) ? Convert.ToString(dict["error"]) : "Reset failed.";
            }
        }
    }
}

<h4 class="mb-1 fw-semibold">Reset Password</h4>
<p class="mb-3 text-muted">Set your new password</p>

@if (success)
{
    <div class="alert alert-success py-2">Your password has been updated.</div>
    <a class="btn btn-primary w-100"
       href="@AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("f6f06000-0000-0000-0000-f6f0f6f0f6f0"), "~/Login")">Log
        In</a>
    }

    @if (!success)
    {
        if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger py-2">@error</div>
        }
        if (!string.IsNullOrEmpty(token))
        {
            <form method="post">
                <div class="mb-3">
                    <label class="form-label">New Password</label>
                    <input type="password" class="form-control" name="password" required="required" />
                </div>
                <div class="mb-3">
                    <label class="form-label">New Password (Repeat)</label>
                    <input type="password" class="form-control" name="confirm" required="required" />
                </div>
                <button type="submit" class="btn btn-primary w-100">Update Password</button>
            </form>
        }
    }
