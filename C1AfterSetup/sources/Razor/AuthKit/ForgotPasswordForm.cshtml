@inherits RazorFunction
@using System

@functions {
    public override string FunctionDescription => "AuthKit sifremi unuttum formu";
}

@{
    var message = "";
    if (IsPost)
    {
        var email = Request.Form["email"];
        AuthKit.Authentication.AuthenticationManager.ForgotPassword(email);
        message = "Eger girdiginiz e-posta adresi sistemimizde kayitliysa, sifirlama talimatlari gonderilmistir.";
    }
}

<h4 class="mb-1 fw-semibold">Şifremi Unuttum</h4>
<p class="mb-3 text-muted">E-posta adresinizi girin, size sıfırlama bağlantısı gönderelim</p>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-success py-2">@message</div>
}

<form method="post">
    <div class="mb-3">
        <label class="form-label">E-posta</label>
        <input type="email" class="form-control" name="email" required="required" />
    </div>
    <button type="submit" class="btn btn-primary w-100">Sıfırlama Bağlantısı Gönder</button>
    <div class="text-center mt-3 small">
        <a href="@AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("f6f06000-0000-0000-0000-f6f0f6f0f6f0"), "~/Login")">Giriş
            Yap</a>
        </div>
    </form>
