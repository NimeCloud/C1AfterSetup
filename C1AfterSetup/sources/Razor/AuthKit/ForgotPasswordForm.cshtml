@inherits RazorFunction
@using System

@functions {
    public override string FunctionDescription => "AuthKit forgot password form";
}

@{
    var message = "";
    if (IsPost)
    {
        var email = Request.Form["email"];
        AuthKit.Authentication.AuthenticationManager.ForgotPassword(email);
        message = "If the email address you entered is registered in our system, reset instructions have been sent.";
    }
}

<h4 class="mb-1 fw-semibold">Forgot Password</h4>
<p class="mb-3 text-muted">Enter your email address and we'll send you a reset link</p>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-success py-2">@message</div>
}

<form method="post">
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" class="form-control" name="email" required="required" />
    </div>
    <button type="submit" class="btn btn-primary w-100">Send Reset Link</button>
    <div class="text-center mt-3 small">
        <a href="@AuthKit.C1.C1UrlHelper.GetUrlFromPageId(new Guid("f6f06000-0000-0000-0000-f6f0f6f0f6f0"), "~/Login")">Log
            In</a>
        </div>
    </form>
